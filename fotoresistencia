#define LDR_PIN 34

void setup() {
  Serial.begin(115200);

  // Configuramos el pin como entrada
  pinMode(LDR_PIN, INPUT);

  Serial.println("Iniciando prueba de LDR...");
}

void loop() {
  int valorLDR = analogRead(LDR_PIN);

  Serial.print("Valor LDR: ");
  Serial.println(valorLDR);

  delay(500);
}
