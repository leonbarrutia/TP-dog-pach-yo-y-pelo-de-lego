#define PIN_PRESENCIA 27

void setup() {
  Serial.begin(115200);

  pinMode(PIN_PRESENCIA, INPUT);

  Serial.println("Sensor LD2410C iniciado");
}

void loop() {

  int presencia = digitalRead(PIN_PRESENCIA);

  if (presencia == HIGH) {
    Serial.println("PERSONA DETECTADA");
  } 
  else {
    Serial.println("NO HAY PERSONA");
  }

  delay(500);
}
